load("@nogo-analyzer//private:go_bazel_test.bzl", "go_bazel_test")

# gazelle:lang test_filegroup

[
    go_bazel_test(
        name = i,
        size = "medium",
        srcs = [
            i + "_test.go",
            "util.go",
        ],
        rule_files = [
            "@nogo-analyzer//:all_files",
            "@rules_go//:all_files",
            "@gazelle//:all_files",
        ],
    )
    for i in [
        "errcheck",
        "gofmt",
        "goimports",
        "ineffassign",
        "prealloc",
    ]
]

filegroup(
    name = "all_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "errcheck_test.go",
        "go.mod",
        "go.sum",
        "gofmt_test.go",
        "goimports_test.go",
        "ineffassign_test.go",
        "prealloc_test.go",
        "util.go",
    ],
    visibility = ["//visibility:public"],
)
